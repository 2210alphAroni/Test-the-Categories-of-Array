C++ code:
#include <iostream>
int main() {
    int* arr = new int[5];  // Heap allocated, fixed size
    for (int i = 0; i < 5; ++i)
        arr[i] = i;
    for (int i = 0; i < 5; ++i)
        std::cout << arr[i] << " ";
    delete[] arr;
    return 0;
}


